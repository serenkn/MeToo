# Neon (PostgreSQL)
# プール接続URL（アプリ実行用）
DATABASE_URL=

# Neon直接接続URL（prisma migrate dev 用）
DIRECT_URL=

# NextAuth.js v5
# openssl rand -base64 32 で生成
AUTH_SECRET=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# R2公開URL（ブラウザに露出するため NEXT_PUBLIC_ プレフィックス）
NEXT_PUBLIC_R2_PUBLIC_URL=

# Pusher
PUSHER_APP_ID=
PUSHER_SECRET=

# Pusherクライアント側（ブラウザに露出）
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=ap3

# Resend（パスワードリセットメール送信）
RESEND_API_KEY=

# 送信元メールアドレス（例: noreply@yourdomain.com）
EMAIL_FROM=
